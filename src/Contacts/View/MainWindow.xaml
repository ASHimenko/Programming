<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contacts" MinWidth="600" MinHeight="450" Height="500" Width="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="150" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F8F8F8">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="3">
                    <Label Content="Find:" Padding="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBox HorizontalAlignment="Stretch" Width="150"/>
                </StackPanel>

                <ListBox Grid.Row="1" Margin="3" 
                         ItemsSource="{Binding Contacts}" 
                         SelectedItem="{Binding SelectedContact}"
                         DisplayMemberPath="Name"/>

                <UniformGrid Grid.Row="2" Columns="3">
                    <Button Content="Add" Height="25" Margin="3" Command="{Binding AddCommand}"/>
                    <Button Content="Edit" Height="25" Margin="3" Command="{Binding EditCommand}"/>
                    <Button Content="Remove" Height="25" Margin="3" Command="{Binding RemoveCommand}"/>
                </UniformGrid>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" 
                      Width="3" 
                      Background="White" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Stretch"/>

        <Border Grid.Column="2" Background="White">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="100" Height="100" 
                Background="#F0F0F0" 
                Margin="3" VerticalAlignment="Top">
                    <Path Data="M12,12C14.21,12 16,10.21 16,8C16,5.79 14.21,4 12,4C9.79,4 8,5.79 8,8C8,10.21 9.79,12 12,12M12,14C9.33,14 4,15.33 4,18V20H20V18C20,15.33 14.67,14 12,14Z" 
                  Fill="Gray" Stretch="Uniform" Margin="25"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Top">

                    <Label Content="Name:" Margin="3,3,3,0"/>
                    <TextBox Text="{Binding SelectedContact.Name}" IsReadOnly="{Binding IsReadOnly}" Margin="3"/>

                    <Label Content="Phone Number:" Margin="3,3,3,0"/>
                    <TextBox Text="{Binding SelectedContact.PhoneNumber}" IsReadOnly="{Binding IsReadOnly}" Margin="3"/>

                    <Label Content="Email:" Margin="3,3,3,0"/>
                    <TextBox Text="{Binding SelectedContact.Email}" IsReadOnly="{Binding IsReadOnly}" Margin="3"/>

                    <Button Content="Apply" 
                    Width="75" Height="25" 
                    HorizontalAlignment="Left"
                    Margin="3,50,3,3"
                    Visibility="{Binding ApplyButtonVisibility}"
                    Command="{Binding ApplyCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>