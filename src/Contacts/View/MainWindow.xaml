<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contacts" MinWidth="600" MinHeight="450" Height="500" Width="800"
        xmlns:cntrls="clr-namespace:View.Controls">

    <Window.Resources>
        <DataTemplate x:Key="ContactTemplate">
            <Border Padding="5" BorderThickness="0,0,0,1" BorderBrush="#EEEEEE">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Fill="#F0F0F0" Stroke="#DDDDDD" StrokeThickness="1"/>

                        <Path Fill="#AAAAAA" Stretch="Uniform" Margin="8"
                          Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,16 20,18V20H4V18C4,16 7.58,14 12,14Z" />
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" 
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Foreground="#333333"/>
                        <TextBlock Text="{Binding PhoneNumber}" 
                               FontSize="12" 
                               Foreground="Gray" 
                               Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="150" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F8F8F8">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="3">
                    <Label Content="Find:" Padding="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBox HorizontalAlignment="Stretch" Width="150"/>
                </StackPanel>

                <ListBox Grid.Row="1" Margin="3" 
                     ItemsSource="{Binding Contacts}" 
                     SelectedItem="{Binding SelectedContact}"
                     ItemTemplate="{StaticResource ContactTemplate}"
                     HorizontalContentAlignment="Stretch"> 
                </ListBox>

                <UniformGrid Grid.Row="2" Columns="3">
                    <Button Content="Add" Height="25" Margin="3" Command="{Binding AddCommand}"/>
                    <Button Content="Edit" Height="25" Margin="3" Command="{Binding EditCommand}"/>
                    <Button Content="Remove" Height="25" Margin="3" Command="{Binding RemoveCommand}"/>
                </UniformGrid>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" 
                      Width="3" 
                      Background="White" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Stretch"/>

        <Border Grid.Column="2" Background="White">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

               

                <StackPanel Grid.Column="1" VerticalAlignment="Top">

                    <cntrls:ContactControl DataContext="{Binding EditingContact}">
                        <cntrls:ContactControl.Style>
                            <Style TargetType="UserControl">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding  DataContext, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </cntrls:ContactControl.Style>
                    </cntrls:ContactControl>
                    <Button Content="Apply" 
                    Width="75" Height="25"
                    Visibility="{Binding ApplyButtonVisibility}"
                    Command="{Binding ApplyCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>